    "   \"source\": [\n",
    "    \"def get_or_compute_fft(image_path, cache_dir=\\\"fft_cache\\\"):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Compute the 2D Fourier Transform (with shift) of a grayscale image.\\n\",\n",
    "    \"    If the result is cached, load it directly from disk.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        image_path (str): Full path to the image file.\\n\",\n",
    "    \"        cache_dir (str): Directory to store cached FFT results.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        np.ndarray: 2D Fourier Transform (shifted) of the image.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    if not os.path.exists(cache_dir):\\n\",\n",
    "    \"        os.makedirs(cache_dir)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Construct cache file path\\n\",\n",
    "    \"    base_name = os.path.splitext(os.path.basename(image_path))[0]\\n\",\n",
    "    \"    cache_file = os.path.join(cache_dir, f\\\"{base_name}.npy\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # If cached result exists, load it\\n\",\n",
    "    \"    if os.path.exists(cache_file):\\n\",\n",
    "    \"        fft_shift = np.load(cache_file)\\n\",\n",
    "    \"        return fft_shift\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Otherwise, read the image, compute FFT, and cache the result\\n\",\n",
    "    \"    img = cv2.imread(image_path, cv2.IMREAD_COLOR)\\n\",\n",
    "    \"    if img is None:\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Could not read image: {image_path}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Convert to grayscale and float32 in [0,1]\\n\",\n",
    "    \"    img_gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY).astype(np.float32) / 255.0\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Compute FFT and shift\\n\",\n",
    "    \"    fft_result = fft2(img_gray)\\n\",\n",
    "    \"    fft_shift = fftshift(fft_result)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Save to cache\\n\",\n",
    "    \"    np.save(cache_file, fft_shift)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return fft_shift\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def process_images_with_fourier_and_labels(path, dataframe, output_features_file=\\\"fourier_features_with_labels.csv\\\", cache_dir=\\\"fft_cache\\\"):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Process images to extract Fourier features and associate them with labels from the provided dataframe.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        path (str): Path to the dataset containing images ('Well-exposed' subfolder).\\n\",\n",
    "    \"        dataframe (pd.DataFrame): DataFrame containing 'image' and 'label' columns.\\n\",\n",
    "    \"        output_features_file (str): File path to save the extracted features.\\n\",\n",
    "    \"        cache_dir (str): Directory to store or retrieve cached FFT results.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        pd.DataFrame: DataFrame containing Fourier features and associated labels.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    image_path = os.path.join(path, 'Well-exposed')\\n\",\n",
    "    \"    features = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for image_file in tqdm(os.listdir(image_path), desc=\\\"Computing Fourier features\\\"):\\n\",\n",
    "    \"        # Remove the extension to find the label\\n\",\n",
    "    \"        image_name_no_ext = os.path.splitext(image_file)[0]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Find the label in the dataframe\\n\",\n",
    "    \"        label_row = dataframe[dataframe['image'] == image_name_no_ext]\\n\",\n",
    "    \"        if label_row.empty:\\n\",\n",
    "    \"            print(f\\\"Warning: No label found for {image_file}. Skipping.\\\")\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        label = label_row['label'].values[0]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Full path to the current image\\n\",\n",
    "    \"        full_img_path = os.path.join(image_path, image_file)\\n\",\n",
    "    \"        if not os.path.exists(full_img_path):\\n\",\n",
    "    \"            print(f\\\"Warning: File {full_img_path} does not exist. Skipping.\\\")\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Get or compute the shifted FFT\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            fft_shift = get_or_compute_fft(full_img_path, cache_dir=cache_dir)\\n\",\n",
    "    \"        except FileNotFoundError as e:\\n\",\n",
    "    \"            print(e)\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Compute the magnitude spectrum\\n\",\n",
    "    \"        magnitude_spectrum = np.abs(fft_shift)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Extract Fourier-based features\\n\",\n",
    "    \"        mean_magnitude = np.mean(magnitude_spectrum)\\n\",\n",
    "    \"        variance_magnitude = np.var(magnitude_spectrum)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Simple partition of frequency domain into \\\"low\\\" (top-left quadrant)\\n\",\n",
    "    \"        # and \\\"high\\\" (bottom-right quadrant) for demonstration\\n\",\n",
    "    \"        h, w = magnitude_spectrum.shape\\n\",\n",
    "    \"        high_freq_energy = np.sum(magnitude_spectrum[h//2:, w//2:])\\n\",\n",
    "    \"        low_freq_energy = np.sum(magnitude_spectrum[:h//2, :w//2])\\n\",\n",
    "    \"        energy_ratio = high_freq_energy / (low_freq_energy + 1e-8)  # Avoid division by zero\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        features.append([\\n\",\n",
    "    \"            image_name_no_ext, \\n\",\n",
    "    \"            label, \\n\",\n",
    "    \"            mean_magnitude, \\n\",\n",
    "    \"            variance_magnitude, \\n\",\n",
    "    \"            high_freq_energy, \\n\",\n",
    "    \"            low_freq_energy, \\n\",\n",
    "    \"            energy_ratio\\n\",\n",
    "    \"        ])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create a DataFrame and save\\n\",\n",
    "    \"    columns = [\\\"image\\\", \\\"label\\\", \\\"MeanMagnitude\\\", \\\"VarianceMagnitude\\\", \\n\",\n",
    "    \"               \\\"HighFreqEnergy\\\", \\\"LowFreqEnergy\\\", \\\"EnergyRatio\\\"]\\n\",\n",
    "    \"    features_df = pd.DataFrame(features, columns=columns)\\n\",\n",
    "    \"    features_df.to_csv(output_features_file, index=False)\\n\",\n",
    "    \"    print(f\\\"Features saved to {output_features_file}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return features_df\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def statistical_comparison(df):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Perform ANOVA for each feature across classes.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        df (pd.DataFrame): DataFrame containing at least 'label' and numerical feature columns.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    features = [\\\"MeanMagnitude\\\", \\\"VarianceMagnitude\\\", \\\"HighFreqEnergy\\\", \\\"LowFreqEnergy\\\", \\\"EnergyRatio\\\"]\\n\",\n",
    "    \"    for feature in tqdm(features, desc=\\\"Statistical Comparison via ANOVA\\\"):\\n\",\n",
    "    \"        data_by_class = [df[df[\\\"label\\\"] == lbl][feature] for lbl in df[\\\"label\\\"].unique()]\\n\",\n",
    "    \"        f_stat, p_value = f_oneway(*data_by_class)\\n\",\n",
    "    \"        print(f\\\"ANOVA for {feature}: F-stat = {f_stat:.4f}, p-value = {p_value:.4e}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def visualize_fourier_examples_with_names(path, dataframe, num_examples=3, cache_dir=\\\"fft_cache\\\"):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Visualize Fourier spectra for a few example images for each label in order,\\n\",\n",
    "    \"    including the image name in the title.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        path (str): Path to the dataset containing images ('Well-exposed' subfolder).\\n\",\n",
    "    \"        dataframe (pd.DataFrame): DataFrame containing 'image' and 'label' columns.\\n\",\n",
    "    \"        num_examples (int): Number of examples to visualize per label.\\n\",\n",
    "    \"        cache_dir (str): Directory to store or retrieve cached FFT results.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    image_path = os.path.join(path, 'Well-exposed')\\n\",\n",
    "    \"    labels = sorted(dataframe['label'].unique())\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    fig, axes = plt.subplots(len(labels), num_examples * 2, figsize=(num_examples * 6, len(labels) * 3))\\n\",\n",
    "    \"    fig.subplots_adjust(hspace=0.5, wspace=0.5)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for i, label in enumerate(labels):\\n\",\n",
    "    \"        label_df = dataframe[dataframe['label'] == label]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Sample `num_examples` images for the current label\\n\",\n",
    "    \"        sampled_images = label_df.sample(n=num_examples, random_state=42)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        for j, (_, row) in enumerate(sampled_images.iterrows()):\\n\",\n",
    "    \"            image_name = row['image']\\n\",\n",
    "    \"            image_file = f\\\"{image_name}.jpeg\\\"\\n\",\n",
    "    \"            full_img_path = os.path.join(image_path, image_file)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            if not os.path.exists(full_img_path):\\n\",\n",
    "    \"                print(f\\\"Warning: Could not find {full_img_path}. Skipping.\\\")\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Retrieve (or compute) FFT\\n\",\n",
    "    \"            try:\\n\",\n",
    "    \"                fft_shift = get_or_compute_fft(full_img_path, cache_dir=cache_dir)\\n\",\n",
    "    \"            except FileNotFoundError as e:\\n\",\n",
    "    \"                print(e)\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"            magnitude_spectrum = np.abs(fft_shift)\\n\",\n",
    "    \"            log_spectrum = np.log1p(magnitude_spectrum)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Read the image for display\\n\",\n",
    "    \"            img = cv2.imread(full_img_path, cv2.IMREAD_GRAYSCALE)\\n\",\n",
    "    \"            if img is None:\\n\",\n",
    "    \"                print(f\\\"Warning: Could not read {full_img_path}. Skipping.\\\")\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Show the original image\\n\",\n",
    "    \"            ax_img = axes[i, j*2]\\n\",\n",
    "    \"            ax_img.imshow(img, cmap='gray')\\n\",\n",
    "    \"            ax_img.set_title(f'Label: {label}\\\\nImage: {image_name}')\\n\",\n",
    "    \"            ax_img.axis('off')\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Show the Fourier spectrum (log scale)\\n\",\n",
    "    \"            ax_spectrum = axes[i, j*2 + 1]\\n\",\n",
    "    \"            ax_spectrum.imshow(log_spectrum, cmap='gray')\\n\",\n",
    "    \"            ax_spectrum.set_title(f'Fourier Spectrum\\\\nImage: {image_name}')\\n\",\n",
    "    \"            ax_spectrum.axis('off')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_aggregated_spectral_features(features_df):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Plot aggregated spectral features for each class in a subplot layout with normalized x-axes per column.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        features_df (pd.DataFrame): DataFrame containing spectral features with columns:\\n\",\n",
    "    \"                                   'label', 'MeanMagnitude', 'VarianceMagnitude',\\n\",\n",
    "    \"                                   'HighFreqEnergy', 'LowFreqEnergy', 'EnergyRatio'.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    feature_columns = [\\n\",\n",
    "    \"        \\\"MeanMagnitude\\\",\\n\",\n",
    "    \"        \\\"VarianceMagnitude\\\",\\n\",\n",
    "    \"        \\\"HighFreqEnergy\\\",\\n\",\n",
    "    \"        \\\"LowFreqEnergy\\\",\\n\",\n",
    "    \"        \\\"EnergyRatio\\\"\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    class_labels = sorted(features_df['label'].unique())\\n\",\n",
    "    \"    num_classes = len(class_labels)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create figure and axes\\n\",\n",
    "    \"    fig, axes = plt.subplots(nrows=num_classes, ncols=len(feature_columns), \\n\",\n",
    "    \"                            figsize=(20, 4 * num_classes))\\n\",\n",
    "    \"    fig.suptitle(\\\"Aggregated Spectral Features by Class\\\", fontsize=16, y=1.02)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # First pass: Find min and max values for each feature\\n\",\n",
    "    \"    feature_ranges = {}\\n\",\n",
    "    \"    for feature in feature_columns:\\n\",\n",
    "    \"        min_val = features_df[feature].min()\\n\",\n",
    "    \"        max_val = features_df[feature].max()\\n\",\n",
    "    \"        # Add a small buffer (5%) to the range\\n\",\n",
    "    \"        range_buffer = (max_val - min_val) * 0.05\\n\",\n",
    "    \"        feature_ranges[feature] = (min_val - range_buffer, max_val + range_buffer)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Second pass: Create plots with normalized axes\\n\",\n",
    "    \"    for i, label in enumerate(class_labels):\\n\",\n",
    "    \"        class_data = features_df[features_df['label'] == label]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        for j, feature in enumerate(feature_columns):\\n\",\n",
    "    \"            ax = axes[i, j] if num_classes > 1 else axes[j]\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Create boxplot\\n\",\n",
    "    \"            ax.boxplot(class_data[feature], vert=False)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Set consistent x-axis limits for this feature\\n\",\n",
    "    \"            ax.set_xlim(feature_ranges[feature])\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Add labels\\n\",\n",
    "    \"            if i == 0:\\n\",\n",
    "    \"                ax.set_title(feature, fontsize=12)\\n\",\n",
    "    \"            if j == 0:\\n\",\n",
    "    \"                ax.set_ylabel(f\\\"Class {label}\\\", fontsize=12)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Add grid for better readability\\n\",\n",
    "    \"            ax.grid(True, linestyle='--', alpha=0.7)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Format axis ticks\\n\",\n",
    "    \"            ax.tick_params(axis='both', which='major', labelsize=10)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def perform_tukey_posthoc_with_heatmap(data, label_column='label'):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Perform Tukey's post-hoc analysis for all numerical features in the dataset and plot heatmaps.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"    - data (pd.DataFrame): Data containing features and labels.\\n\",\n",
    "    \"    - label_column (str): Column name of the class labels.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"    - dict: Dictionary containing Tukey test results for each feature.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    features_to_analyze = data.select_dtypes(include=[np.number]).columns.drop(label_column)\\n\",\n",
    "    \"    class_labels = data[label_column].unique()\\n\",\n",
    "    \"    class_labels.sort()\\n\",\n",
    "    \"    num_classes = len(class_labels)\\n\",\n",
    "    \"    tukey_results = {}\\n\",\n",
    "    \"    heatmaps_data = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for feature in features_to_analyze:\\n\",\n",
    "    \"        tukey = pairwise_tukeyhsd(endog=data[feature], groups=data[label_column], alpha=0.05)\\n\",\n",
    "    \"        df_tukey = pd.DataFrame(tukey._results_table.data[1:], columns=tukey._results_table.data[0])\\n\",\n",
    "    \"        tukey_results[feature] = df_tukey\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Build matrix for heatmap\\n\",\n",
    "    \"        heatmap_matrix = np.zeros((num_classes, num_classes), dtype=int)\\n\",\n",
    "    \"        for _, row in df_tukey.iterrows():\\n\",\n",
    "    \"            g1, g2, p_value = int(row[\\\"group1\\\"]), int(row[\\\"group2\\\"]), row[\\\"p-adj\\\"]\\n\",\n",
    "    \"            if p_value < 0.05:\\n\",\n",
    "    \"                heatmap_matrix[g1, g2] = 1\\n\",\n",
    "    \"                heatmap_matrix[g2, g1] = 1\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                heatmap_matrix[g1, g2] = -1\\n\",\n",
    "    \"                heatmap_matrix[g2, g1] = -1\\n\",\n",
    "    \"\\n\",\n",
    "    \"        np.fill_diagonal(heatmap_matrix, 0)\\n\",\n",
    "    \"        heatmaps_data[feature] = heatmap_matrix\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot heatmaps\\n\",\n",
    "    \"    num_features = len(features_to_analyze)\\n\",\n",
    "    \"    rows = (num_features + 2) // 3  # up to 3 columns per row\\n\",\n",
    "    \"    fig, axes = plt.subplots(rows, 3, figsize=(18, 6 * rows))\\n\",\n",
    "    \"    axes = axes.flatten() if rows > 1 else axes\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i, feature in enumerate(features_to_analyze):\\n\",\n",
    "    \"        sns.heatmap(\\n\",\n",
    "    \"            heatmaps_data[feature], \\n\",\n",
    "    \"            annot=True, \\n\",\n",
    "    \"            cbar=False, \\n\",\n",
    "    \"            xticklabels=class_labels, \\n\",\n",
    "    \"            yticklabels=class_labels, \\n\",\n",
    "    \"            ax=axes[i], \\n\",\n",
    "    \"            cmap=\\\"coolwarm\\\", \\n\",\n",
    "    \"            linewidths=0.5, \\n\",\n",
    "    \"            center=0, \\n\",\n",
    "    \"            vmin=-1, \\n\",\n",
    "    \"            vmax=1\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        axes[i].set_title(feature, fontsize=14)\\n\",\n",
    "    \"        axes[i].set_xlabel(\\\"Class\\\", fontsize=12)\\n\",\n",
    "    \"        axes[i].set_ylabel(\\\"Class\\\", fontsize=12)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Remove any unused subplots\\n\",\n",
    "    \"    for j in range(len(features_to_analyze), len(axes)):\\n\",\n",
    "    \"        fig.delaxes(axes[j])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return tukey_results\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_average_fourier(path, labels_df, target_size=(512, 512), cache_dir=\\\"fft_cache\\\"):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Compute average Fourier magnitude spectrum for each class.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        path (str): Base directory containing images.\\n\",\n",
    "    \"        labels_df (pd.DataFrame): DataFrame containing 'image' and 'label' columns.\\n\",\n",
    "    \"        target_size (tuple): Size to resize images for consistency.\\n\",\n",
    "    \"        cache_dir (str): Directory to store or retrieve cached FFT results.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        dict: A dictionary where keys are class labels and values are average Fourier spectra.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    class_fourier = {}\\n\",\n",
    "    \"    classes = labels_df['label'].unique()\\n\",\n",
    "    \"    well_exposed_path = os.path.join(path, 'Well-exposed')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for cls in classes:\\n\",\n",
    "    \"        class_images = labels_df[labels_df['label'] == cls]['image']\\n\",\n",
    "    \"        accumulated_magnitude = None\\n\",\n",
    "    \"        count = 0\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        for img_name in tqdm(class_images, desc=f\\\"Processing class {cls}\\\"):\\n\",\n",
    "    \"            img_file = os.path.join(well_exposed_path, f\\\"{img_name}.jpeg\\\")\\n\",\n",
    "    \"            if not os.path.exists(img_file):\\n\",\n",
    "    \"                # print(f\\\"Warning: File {img_file} does not exist.\\\")\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Optionally, read and resize for consistency in shape\\n\",\n",
    "    \"            img = cv2.imread(img_file, cv2.IMREAD_COLOR)\\n\",\n",
    "    \"            if img is None:\\n\",\n",
    "    \"                print(f\\\"Warning: Could not read {img_file}.\\\")\\n\",\n",
    "    \"                continue\\n\",\n",
    "    \"            img_resized = cv2.resize(img, target_size)\\n\",\n",
    "    \"            gray_img = cv2.cvtColor(img_resized, cv2.COLOR_BGR2GRAY)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Instead of computing FFT from scratch, you could cache the resized version.\\n\",\n",
    "    \"            # For simplicity, we'll compute it here each time (resize changes shape).\\n\",\n",
    "    \"            fft_result = fft2(gray_img)\\n\",\n",
    "    \"            fft_shifted = fftshift(fft_result)\\n\",\n",
    "    \"            magnitude = np.abs(fft_shifted)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if accumulated_magnitude is None:\\n\",\n",
    "    \"                accumulated_magnitude = magnitude\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                accumulated_magnitude += magnitude\\n\",\n",
    "    \"            count += 1\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        if count > 0:\\n\",\n",
    "    \"            class_fourier[cls] = accumulated_magnitude / count\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return class_fourier\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def visualize_unique_frequencies(class_fourier):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Visualize unique frequency patterns for each class.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        class_fourier (dict): Dictionary of average Fourier spectra for each class.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    classes = list(class_fourier.keys())\\n\",\n",
    "    \"    n_classes = len(classes)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    fig, axes = plt.subplots(n_classes, n_classes, figsize=(15, 15))\\n\",\n",
    "    \"    fig.suptitle(\\\"Unique Intra-Class Frequencies\\\", fontsize=16)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for i, class_i in enumerate(classes):\\n\",\n",
    "    \"        for j, class_j in enumerate(classes):\\n\",\n",
    "    \"            if i == j:\\n\",\n",
    "    \"                # Diagonal: show the average spectrum for this class\\n\",\n",
    "    \"                spectrum = class_fourier[class_i]\\n\",\n",
    "    \"                axes[i, j].imshow(np.log1p(spectrum), cmap='viridis')\\n\",\n",
    "    \"                axes[i, j].set_title(f\\\"Class {class_i}\\\")\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                # Off-diagonal: show the difference spectrum\\n\",\n",
    "    \"                diff_spectrum = class_fourier[class_i] - class_fourier[class_j]\\n\",\n",
    "    \"                axes[i, j].imshow(np.log1p(np.abs(diff_spectrum)), cmap='coolwarm')\\n\",\n",
    "    \"                axes[i, j].set_title(f\\\"{class_i} vs {class_j}\\\")\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            axes[i, j].axis('off')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    dataset_path = \\\"Data/Preprocessed\\\"\\n\",\n",
    "    \"    labels_df = pd.read_csv(\\\"Data/Preprocessed/exposure_results_with_labels.csv\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 1. Compute and store Fourier features\\n\",\n",
    "    \"    fourier_features_df = process_images_with_fourier_and_labels(dataset_path, labels_df)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 2. Statistical comparison\\n\",\n",
    "    \"    statistical_comparison(fourier_features_df)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 3. Visualization of examples\\n\",\n",
    "    \"    visualize_fourier_examples_with_names(dataset_path, labels_df)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 4. Aggregated spectral features\\n\",\n",
    "    \"    plot_aggregated_spectral_features(fourier_features_df)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 5. Tukey post-hoc tests\\n\",\n",
    "    \"    perform_tukey_posthoc_with_heatmap(fourier_features_df)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 6. Compute average spectra for each class\\n\",\n",
    "    \"    class_fourier = compute_average_fourier(dataset_path, labels_df)\\n\",\n",
    "    \"    visualize_unique_frequencies(class_fourier)\"\n",
