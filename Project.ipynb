    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def process_histogram_statistics(df):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Modified version to properly parse string histograms using ast\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    def parse_histogram(hist_string):\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            # Use ast.literal_eval to safely evaluate the string representation\\n\",\n",
    "    \"            hist_list = ast.literal_eval(hist_string)\\n\",\n",
    "    \"            return np.array(hist_list)\\n\",\n",
    "    \"        except (ValueError, SyntaxError) as e:\\n\",\n",
    "    \"            print(f\\\"Error parsing histogram: {e}\\\")\\n\",\n",
    "    \"            return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert the 'histogram' column from strings to numpy arrays\\n\",\n",
    "    \"    df['histogram'] = df['histogram'].apply(parse_histogram)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Remove rows where histogram parsing failed\\n\",\n",
    "    \"    df = df.dropna(subset=['histogram'])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Group by category\\n\",\n",
    "    \"    grouped = df.groupby('category')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for category, group in grouped:\\n\",\n",
    "    \"        # Stack histograms for the category\\n\",\n",
    "    \"        histograms = np.stack(group['histogram'].to_numpy())\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Calculate aggregated histogram (mean) and standard deviation\\n\",\n",
    "    \"        aggregated_histogram = np.mean(histograms, axis=0)\\n\",\n",
    "    \"        std_histogram = np.std(histograms, axis=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Call the plotting function\\n\",\n",
    "    \"        plot_histogram_statistics(aggregated_histogram, std_histogram, category)\"\n",
    "   ],\n",
    "   \"id\": \"1f22f9a0156d283d\",\n",
    "   \"outputs\": [],\n",
