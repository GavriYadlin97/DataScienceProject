    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def plot_histogram_statistics(aggregated_histogram, std_histogram, name):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Plots the aggregated pixel intensity histogram with statistical markers (mean, median, mode),\\n\",\n",
    "    \"    the standard deviation range, and includes an additional plot in symmetric log scale with symmetric limits.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Parameters:\\n\",\n",
    "    \"        aggregated_histogram (np.ndarray): The aggregated histogram of pixel intensities (length 256).\\n\",\n",
    "    \"        std_histogram (np.ndarray): The standard deviation of the histogram values (length 256).\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        None\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    def plot_histogram(intensities, histogram, std, mean_val, median_val, mode_val, log_scale=False, symmetric_limit=None):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Internal function to handle plotting logic.\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Parameters:\\n\",\n",
    "    \"            intensities (np.ndarray): Pixel intensity values (0-255).\\n\",\n",
    "    \"            histogram (np.ndarray): Histogram values for the intensities.\\n\",\n",
    "    \"            std (np.ndarray): Standard deviation for the histogram values.\\n\",\n",
    "    \"            mean_val (float): Mean pixel intensity value.\\n\",\n",
    "    \"            median_val (float): Median pixel intensity value.\\n\",\n",
    "    \"            mode_val (float): Mode pixel intensity value.\\n\",\n",
    "    \"            log_scale (bool): Whether to use a log or symmetric log scale for the y-axis.\\n\",\n",
    "    \"            symmetric_limit (float): Maximum value for symmetric y-axis limits (used in symlog scale).\\n\",\n",
    "    \"\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            None\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        plt.figure(figsize=(12, 6))\\n\",\n",
    "    \"        plt.bar(intensities, histogram, color=\\\"gray\\\", alpha=0.7, label=\\\"Mean Histogram\\\")\\n\",\n",
    "    \"        plt.fill_between(intensities,\\n\",\n",
    "    \"                         histogram - std,  # Lower bound\\n\",\n",
    "    \"                         histogram + std,  # Upper bound\\n\",\n",
    "    \"                         color=\\\"blue\\\", alpha=0.3, label=\\\"Std Dev Range\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Add vertical lines for statistics\\n\",\n",
    "    \"        plt.axvline(mean_val, color=\\\"red\\\", linestyle=\\\"--\\\", linewidth=1.5, label=f\\\"Mean: {mean_val:.2f}\\\")\\n\",\n",
    "    \"        plt.axvline(median_val, color=\\\"green\\\", linestyle=\\\"--\\\", linewidth=1.5, label=f\\\"Median: {median_val:.2f}\\\")\\n\",\n",
    "    \"        plt.axvline(mode_val, color=\\\"orange\\\", linestyle=\\\"--\\\", linewidth=1.5, label=f\\\"Mode: {mode_val:.0f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        plt.title(\\\"Aggregated Pixel Intensity Histogram\\\" + (\\\" (Log Scale)\\\" if log_scale else \\\"\\\") + \\\" - \\\" + name, fontsize=16)\\n\",\n",
    "    \"        plt.xlabel(\\\"Pixel Intensity\\\", fontsize=14)\\n\",\n",
    "    \"        plt.ylabel(\\\"Log(Frequency)\\\" if log_scale else \\\"Frequency\\\", fontsize=14)\\n\",\n",
    "    \"        plt.legend(fontsize=12)\\n\",\n",
    "    \"        plt.grid(alpha=0.4)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Set x-ticks at every 16\\n\",\n",
    "    \"        plt.xticks(ticks=np.arange(0, 256 + 16, 16))  # Add ticks from 0 to 256 with a step of 16\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Set y-axis to log scale if required\\n\",\n",
    "    \"        if log_scale:\\n\",\n",
    "    \"            plt.yscale(\\\"symlog\\\", linthresh=1)  # Symmetric log scale with a linear threshold at ±1\\n\",\n",
    "    \"            plt.ylim(-symmetric_limit, symmetric_limit)  # Ensure symmetric y-axis limits\\n\",\n",
    "    \"\\n\",\n",
    "    \"        plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Define the range of pixel intensities (0 to 255)\\n\",\n",
    "    \"    intensities = np.arange(256)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate statistical values\\n\",\n",
    "    \"    mean_val = np.sum(aggregated_histogram * intensities) / np.sum(aggregated_histogram)\\n\",\n",
    "    \"    cdf = np.cumsum(aggregated_histogram) / np.sum(aggregated_histogram)\\n\",\n",
    "    \"    median_val = np.interp(0.5, cdf, intensities)\\n\",\n",
    "    \"    mode_val = intensities[np.argmax(aggregated_histogram)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot the regular histogram\\n\",\n",
    "    \"    plot_histogram(intensities, aggregated_histogram, std_histogram, mean_val, median_val, mode_val, log_scale=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate the maximum magnitude of the histogram for symmetric log-scale limits\\n\",\n",
    "    \"    max_val = np.max(np.abs(aggregated_histogram + std_histogram))\\n\",\n",
    "    \"    symmetric_limit = 10 ** np.ceil(np.log10(max_val))  # Round up to the nearest power of 10\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot the log-scale histogram with symmetric limits\\n\",\n",
    "    \"    plot_histogram(intensities, aggregated_histogram, std_histogram, mean_val, median_val, mode_val, log_scale=True, symmetric_limit=symmetric_limit)\"\n",
    "   ],\n",
    "   \"id\": \"6f603a0cff76abcc\",\n",
